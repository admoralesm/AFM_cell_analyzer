#         stacks_index.csv              rebuildable list of every analysis
#         stacks/
#             <stack_id>/
#                 analysis.json         what is needed to open it again
#                 plot.html             the plot, interactive
#                 aligned.csv           the data as plotted
#                 summary.csv           each file's numbers
#                 files/                the files the plot was made from
#
# Beat analyses the same way, in beats/ with beats_index.csv: one line per
# analysis with every result (counts, forces, energies, areas), so the
# index is the data sheet of everything analysed.
#
# As with the cells, analysis.json is the source of truth and the index is
# only a cache: it goes up last, so a save that fails half way leaves no
# entry pointing at a folder with files missing.

def safe_name(name):
    """A name OneDrive accepts: the characters it refuses replaced."""
    text = "".join("_" if ch in '\\/:*?"<>|' else ch for ch in str(name))
    return text.strip().strip(".") or "untitled"


# a cell's pictures: photos, and the frames OneDrive shows for videos
PICTURE_TYPES = (".png", ".jpg", ".jpeg", ".gif", ".bmp", ".tif", ".tiff",
                 ".webp", ".heic")
VIDEO_TYPES = (".mp4", ".mov", ".avi", ".mkv", ".wmv", ".m4v", ".webm",
               ".mpg", ".mpeg")


def picture_kind(name):
    """'image', 'video' or None, by a file's extension."""
    low = str(name or "").lower()
    if low.endswith(PICTURE_TYPES):
        return "image"
    if low.endswith(VIDEO_TYPES):
        return "video"
    return None


_ID_DATE = re.compile(r"(20\d\d)[-_. ]?(0[1-9]|1[0-2])[-_. ]?"
                      r"(0[1-9]|[12]\d|3[01])")


def date_in_id(cell_id):
    """The date a cell's ID (its video's name) starts with or holds, as
    YYYY-MM-DD (2026-11-27_03, 20261127_3, cell 2026.11.27 #3), else ''."""
    found = _ID_DATE.search(str(cell_id or ""))
    return "-".join(found.groups()) if found else ""


def next_cell_id(existing, day):
    """
    The next ID for a cell recorded on ``day`` (YYYY-MM-DD): that date and
    the next number free among the cells of the same date, two digits:
    2026-11-27_01, then 2026-11-27_02… A number after the date is read
    whatever its spelling (2026-11-27_3, 20261127-04, 2026-11-27 cell 5).
    """
    day = str(day)[:10]
    used = []
    for cell in existing or ():
        text = str(cell)
        if date_in_id(text) != day:
            continue
        rest = _ID_DATE.split(text, maxsplit=1)[-1]
        number = re.search(r"\d+", rest)
        if number:
            used.append(int(number.group()))
    return f"{day}_{(max(used) + 1) if used else 1:02d}"


def store_from_secrets(st, root_folder=None):
    """Build a store from ``st.secrets['onedrive']``, or None when unset."""
    try:
        config = dict(st.secrets.get("onedrive", {}))
    except Exception:
        config = {}
    if not config:
        return None
    return OneDriveStore(
        client_id=config.get("client_id"),
        client_secret=config.get("client_secret"),
        account=config.get("account", DEFAULT_ACCOUNT),
        tenant=config.get("tenant"),
        refresh_token=config.get("refresh_token"),
        drive_id=config.get("drive_id"),
        root_folder=root_folder or config.get("root_folder", "AFM cells"),
    )
